{
  "recipe_id": "cd_gate",
  "version": 1,
  "author": "HX",
  "description": "Die-to-die，但分數本身就是缺陷尺寸（像素）：先用差異圖的中心區殘差當「這是不是真的」的閘門，過關的才用最大缺陷區塊的寬高算分，門檻直接填你在意的最小缺陷尺寸。適合「多小的缺陷可以放過」有明確規格的站點。這條也示範 blob 可以直接切 diff，不一定要先做 SNR 地圖。",
  "routes": {
    "ebi_patch": [
      "load",
      "norm",
      "align",
      "sub",
      "dn",
      "blob",
      "cd",
      "glv"
    ]
  },
  "nodes": {
    "load": {
      "step": "load_patch",
      "params": {},
      "enabled": true
    },
    "norm": {
      "step": "percentile_norm",
      "params": {
        "source": "test",
        "also_apply": "ref"
      },
      "enabled": true
    },
    "align": {
      "step": "align",
      "params": {
        "method": "phase",
        "search_radius": 8
      },
      "enabled": true
    },
    "sub": {
      "step": "subtract",
      "params": {},
      "enabled": true
    },
    "dn": {
      "step": "denoise",
      "params": {
        "target": "diff",
        "method": "median",
        "ksize": 3
      },
      "enabled": true
    },
    "blob": {
      "step": "blob_segment",
      "params": {
        "source": "diff",
        "diff_source": "diff",
        "min_area": 6,
        "snr_threshold": 30
      },
      "enabled": true
    },
    "cd": {
      "step": "cd_measure",
      "params": {
        "source": "diff",
        "refine": "none"
      },
      "enabled": true
    },
    "glv": {
      "step": "glv_stats",
      "params": {
        "source": "diff",
        "region": "center",
        "box_size": 32,
        "metrics": "glv_max,glv_median,glv_std"
      },
      "enabled": true
    }
  },
  "edges": [],
  "score": {
    "expr": "(glv_max > 30 and cd_x_px > 2) * max(cd_x_px, cd_y_px)",
    "threshold": 3.0,
    "bins": {
      "below": 0,
      "above": 1
    }
  }
}
