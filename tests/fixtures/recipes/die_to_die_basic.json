{
  "recipe_id": "die_to_die_basic",
  "version": 2,
  "author": "HX",
  "description": "測試用的最小 recipe（不是給使用者看的範例）。ROI 卡在 F8 第五輪收斂成 Profile / Template / GDS，所以這裡量的是整張圖 —— 這幾條 e2e 測的是**引擎跑不跑得完、分數算不算得出來**，不是某一張 ROI 卡的行為。",
  "routes": {
    "ebi_patch": [
      "load",
      "norm_ref",
      "norm",
      "sub",
      "dn",
      "snr",
      "cd",
      "glv"
    ]
  },
  "nodes": {
    "load": {
      "step": "load_patch",
      "params": {},
      "enabled": true
    },
    "norm_ref": {
      "step": "normalize",
      "params": {
        "range_from": "test",
        "streams": "ref",
        "method": "percentile"
      },
      "enabled": true
    },
    "norm": {
      "step": "normalize",
      "params": {
        "streams": "test",
        "method": "percentile"
      },
      "enabled": true
    },
    "sub": {
      "step": "subtract",
      "params": {
        "b": "ref"
      },
      "enabled": true
    },
    "dn": {
      "step": "denoise",
      "params": {
        "method": "median",
        "ksize": 3,
        "streams": "diff"
      },
      "enabled": true
    },
    "snr": {
      "step": "snr_map",
      "params": {
        "window": 15,
        "exclude_border": 8
      },
      "enabled": true
    },
    "cd": {
      "step": "cd_measure",
      "params": {},
      "enabled": true
    },
    "glv": {
      "step": "glv_stats",
      "params": {
        "source": "diff",
        "metrics": "glv_max,glv_q99,glv_mean",
        "roi": ""
      },
      "enabled": true
    }
  },
  "edges": [],
  "score": {
    "expr": "glv_max + (glv_max - glv_q99)",
    "threshold": 50.0,
    "bins": {
      "below": 0,
      "above": 1
    }
  }
}
