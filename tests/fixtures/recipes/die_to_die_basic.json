{
  "recipe_id": "die_to_die_basic",
  "version": 2,
  "author": "HX",
  "description": "\u6e2c\u8a66\u7528\u7684\u6700\u5c0f recipe\uff08\u4e0d\u662f\u7d66\u4f7f\u7528\u8005\u770b\u7684\u7bc4\u4f8b\uff09\u3002ROI \u5361\u5728 F8 \u7b2c\u4e94\u8f2a\u6536\u6582\u6210 Profile / Template / GDS\uff0c\u6240\u4ee5\u9019\u88e1\u91cf\u7684\u662f\u6574\u5f35\u5716 \u2014\u2014 \u9019\u5e7e\u689d e2e \u6e2c\u7684\u662f**\u5f15\u64ce\u8dd1\u4e0d\u8dd1\u5f97\u5b8c\u3001\u5206\u6578\u7b97\u4e0d\u7b97\u5f97\u51fa\u4f86**\uff0c\u4e0d\u662f\u67d0\u4e00\u5f35 ROI \u5361\u7684\u884c\u70ba\u3002",
  "routes": {
    "ebi_patch": [
      "load",
      "norm_ref",
      "norm",
      "sub",
      "dn",
      "cd",
      "glv"
    ]
  },
  "nodes": {
    "load": {
      "step": "load_patch",
      "params": {},
      "enabled": true
    },
    "norm_ref": {
      "step": "normalize",
      "params": {
        "range_from": "test",
        "streams": "ref",
        "method": "percentile"
      },
      "enabled": true
    },
    "norm": {
      "step": "normalize",
      "params": {
        "streams": "test",
        "method": "percentile"
      },
      "enabled": true
    },
    "sub": {
      "step": "subtract",
      "params": {
        "b": "ref"
      },
      "enabled": true
    },
    "dn": {
      "step": "denoise",
      "params": {
        "method": "median",
        "ksize": 3,
        "streams": "diff"
      },
      "enabled": true
    },
    "cd": {
      "step": "cd_measure",
      "params": {
        "source": "test",
        "axis": "x",
        "target": "bright",
        "report": "cd_median,cd_std,cd_min,cd_max"
      },
      "enabled": true
    },
    "glv": {
      "step": "glv_stats",
      "params": {
        "source": "diff",
        "metrics": "glv_max,glv_q99,glv_mean",
        "roi": ""
      },
      "enabled": true
    }
  },
  "edges": [],
  "score": {
    "expr": "glv_max + (glv_max - glv_q99)",
    "threshold": 50.0,
    "bins": {
      "below": 0,
      "above": 1
    }
  }
}
