{
  "recipe_id": "dual_route_basic",
  "version": 1,
  "author": "HX",
  "description": "測試用的最小 recipe（不是給使用者看的範例）。ROI 卡在 F8 第五輪收斂成 Profile / Template / GDS，所以這裡量的是整張圖 —— 這幾條 e2e 測的是**引擎跑不跑得完、分數算不算得出來**，不是某一張 ROI 卡的行為。",
  "routes": {
    "ebi_patch": [
      "load",
      "norm_ref",
      "norm",
      "align",
      "sub",
      "dn",
      "snr",
      "cd",
      "glv_patch"
    ],
    "rsem": [
      "load",
      "golden",
      "norm_ref",
      "norm",
      "align",
      "sub",
      "dn",
      "snr",
      "cd",
      "glv_rsem"
    ]
  },
  "nodes": {
    "load": {
      "step": "load_patch",
      "params": {},
      "enabled": true
    },
    "norm_ref": {
      "step": "normalize",
      "params": {
        "range_from": "test",
        "streams": "ref",
        "method": "percentile"
      },
      "enabled": true
    },
    "norm": {
      "step": "normalize",
      "params": {
        "streams": "test",
        "method": "percentile"
      },
      "enabled": true
    },
    "align": {
      "step": "align",
      "params": {
        "method": "phase",
        "search_radius": 8
      },
      "enabled": true
    },
    "sub": {
      "step": "subtract",
      "params": {
        "b": "ref_aligned"
      },
      "enabled": true
    },
    "dn": {
      "step": "denoise",
      "params": {
        "method": "median",
        "ksize": 5,
        "streams": "diff"
      },
      "enabled": true
    },
    "snr": {
      "step": "snr_map",
      "params": {
        "window": 15,
        "exclude_border": 8
      },
      "enabled": true
    },
    "cd": {
      "step": "cd_measure",
      "params": {},
      "enabled": true
    },
    "glv_patch": {
      "step": "glv_stats",
      "params": {
        "source": "diff",
        "metrics": "glv_max,glv_median,glv_std",
        "roi": ""
      },
      "enabled": true
    },
    "golden": {
      "step": "golden_cell",
      "params": {
        "source": "test",
        "out": "ref",
        "method": "median"
      },
      "enabled": true
    },
    "glv_rsem": {
      "step": "glv_stats",
      "params": {
        "source": "diff",
        "metrics": "glv_max,glv_median,glv_std",
        "roi": ""
      },
      "enabled": true
    }
  },
  "edges": [],
  "score": {
    "expr": "(glv_max - glv_median) / (glv_std + 0.5)",
    "threshold": 4.2,
    "bins": {
      "below": 0,
      "above": 1
    }
  }
}
