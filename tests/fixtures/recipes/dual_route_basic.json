{
  "recipe_id": "dual_route_basic",
  "version": 1,
  "author": "HX",
  "description": "測試用的最小 recipe（不是給使用者看的範例）。ebi_patch 那條有機台附的 ref，所以走「相減 → 去噪 → Z-map → CD → GLV」。rsem 那條**沒有 ref**：F16 拿掉 `pattern_ref` 之後，單張影像再也造不出參考圖，所以它改成直接量單張影像（Z-map → CD → GLV）。那條 route 因此**不再是一個準確率的證據** —— 見 tests/test_e2e_dual_route.py。 rsem 那條的影像流叫 `test` 不是 `single`：那條 route 上的 load 卡是由 `_migrate_split_load_cards` 從共用的 `load_patch` 換成 `load_single` 的，而它把輸出名設成 `test`（見那支遷移的 docstring）——這份 fixture 同時是**那道遷移的共用節點案例**。",
  "routes": {
    "ebi_patch": [
      "load",
      "norm_ref",
      "norm",
      "align",
      "sub",
      "dn",
      "snr",
      "cd",
      "glv_patch"
    ],
    "rsem": [
      "load",
      "snr_rsem",
      "cd_rsem",
      "glv_rsem"
    ]
  },
  "nodes": {
    "load": {
      "step": "load_patch",
      "params": {},
      "enabled": true
    },
    "norm_ref": {
      "step": "normalize",
      "params": {
        "range_from": "test",
        "streams": "ref",
        "method": "percentile"
      },
      "enabled": true
    },
    "norm": {
      "step": "normalize",
      "params": {
        "streams": "test",
        "method": "percentile"
      },
      "enabled": true
    },
    "align": {
      "step": "align",
      "params": {
        "method": "phase",
        "search_radius": 8
      },
      "enabled": true
    },
    "sub": {
      "step": "subtract",
      "params": {
        "b": "ref_aligned"
      },
      "enabled": true
    },
    "dn": {
      "step": "denoise",
      "params": {
        "method": "median",
        "ksize": 5,
        "streams": "diff"
      },
      "enabled": true
    },
    "snr": {
      "step": "snr_map",
      "params": {
        "window": 15,
        "exclude_border": 8
      },
      "enabled": true
    },
    "cd": {
      "step": "cd_measure",
      "params": {},
      "enabled": true
    },
    "glv_patch": {
      "step": "glv_stats",
      "params": {
        "source": "diff",
        "metrics": "glv_max,glv_median,glv_std",
        "roi": ""
      },
      "enabled": true
    },
    "glv_rsem": {
      "step": "glv_stats",
      "params": {
        "source": "test",
        "metrics": "glv_max,glv_median,glv_std",
        "roi": ""
      },
      "enabled": true
    },
    "snr_rsem": {
      "step": "snr_map",
      "params": {
        "source": "test",
        "window": 15,
        "exclude_border": 8,
        "out": "snr_map"
      },
      "enabled": true
    },
    "cd_rsem": {
      "step": "cd_measure",
      "params": {
        "source": "test",
        "roi": ""
      },
      "enabled": true
    }
  },
  "edges": [],
  "score": {
    "expr": "(glv_max - glv_median) / (glv_std + 0.5)",
    "threshold": 4.2,
    "bins": {
      "below": 0,
      "above": 1
    }
  }
}
