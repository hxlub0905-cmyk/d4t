{
  "recipe_id": "doe-conditions",
  "version": 5,
  "app_version": "0.1.0.dev0",
  "author": "d4t",
  "description": "DOE: the same defect imaged under several e-beam conditions, compared on one set of boxes. Every sub-folder is one defect and the images inside it are its conditions; name them on the Load card. The conditions are lined up on whole pixels (nothing is resampled, so the grey levels stay comparable), then one GLV card measures every condition against the same target and reference box and reports snr_px and contrast for each. TO USE THIS ON YOUR OWN DATA: open the ROI card in Studio, drop one of YOUR condition images in as the template and re-draw the two boxes on it - the ones here came from the sample data. DO NOT ADD A NORMALIZE CARD: the brightness difference between the conditions is the thing you are measuring, and normalizing wipes it out.",
  "routes": {
    "doe_folder": [
      "load",
      "align",
      "roi",
      "glv",
      "report"
    ]
  },
  "nodes": {
    "load": {
      "step": "load_patch",
      "params": {
        "channel_map": "1:le300, 2:le500, 3:le800"
      },
      "enabled": true
    },
    "align": {
      "step": "align",
      "params": {
        "streams": "le300,le500,le800",
        "fixed": "le800",
        "method": "phase",
        "search_radius": 8,
        "suffix": ""
      },
      "enabled": true
    },
    "roi": {
      "step": "roi_reference",
      "params": {
        "method": "a cell I mark myself",
        "source": "le800",
        "template": "gc2:128x128:128x128:",
        "regions": "target: 0.42,0.42,0.16,0.16 | ref: 0.09,0.09,0.25,0.25",
        "locate_axis": "both",
        "pick": "none"
      },
      "enabled": true
    },
    "glv": {
      "step": "glv_stats",
      "params": {
        "source": "le300,le500,le800",
        "metrics": "glv_mean",
        "compare_metrics": "snr_px,contrast",
        "stat": "glv_mean",
        "across_boxes": "pooled"
      },
      "enabled": true
    },
    "report": {
      "step": "output_report",
      "params": {
        "folder": "doe_report",
        "contents": "table",
        "title": "DOE - SNR by imaging condition",
        "include_features": true
      },
      "enabled": true
    }
  },
  "edges": [
    [
      "load",
      "le300",
      "align",
      "streams"
    ],
    [
      "load",
      "le500",
      "align",
      "streams"
    ],
    [
      "load",
      "le800",
      "align",
      "streams"
    ],
    [
      "load",
      "le800",
      "align",
      "fixed"
    ],
    [
      "align",
      "le800",
      "roi",
      "source"
    ],
    [
      "roi",
      "target",
      "glv",
      "roi"
    ],
    [
      "roi",
      "ref",
      "glv",
      "reference_region"
    ],
    [
      "align",
      "le300",
      "glv",
      "source"
    ],
    [
      "align",
      "le500",
      "glv",
      "source"
    ],
    [
      "align",
      "le800",
      "glv",
      "source"
    ]
  ],
  "score": {
    "expr": "",
    "threshold": 0.0,
    "bins": {}
  },
  "decide": {
    "let": [
      {
        "name": "best_snr",
        "expr": "max(le300_cmp_snr_px, le500_cmp_snr_px, le800_cmp_snr_px)",
        "fill": "-1"
      }
    ],
    "tree": {
      "when": "best_snr < 0",
      "yes": {
        "bin": 9,
        "label": "nothing to measure"
      },
      "no": {
        "bin": 0,
        "label": "measured"
      }
    },
    "score": "best_snr"
  }
}
